@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="bg-light min-vh-100 py-4">
    <div class="container-fluid px-4">

        <!-- Header Section with Date & Actions -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
            <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="fw-bold text-dark mb-0">
                            <i class="bi bi-speedometer2 text-danger me-2"></i>Admin Dashboard
                        </h2>
                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">Live Store</span>
                    </div>
                    <p class="text-muted small mb-0">Overview of orders, revenue performance, menu inventory, and analytics.</p>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button class="btn btn-outline-secondary rounded-3 fw-semibold shadow-sm" type="button">
                        <i class="bi bi-download me-1"></i> Export Report
                    </button>
                    <a asp-controller="Pizza" asp-action="AddPizza" class="btn btn-danger rounded-3 fw-bold shadow-sm">
                        <i class="bi bi-plus-lg me-1"></i> Add New Pizza
                    </a>
                </div>
            </div>
        </div>

        <!-- Metric KPI Cards Row (Expanded) -->
        <div class="row g-3 mb-4">

            <!-- Total Revenue -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Total Revenue</span>
                                <h3 class="fw-bold text-dark mt-2 mb-0">$12,450.00</h3>
                                <span class="badge bg-success-subtle text-success mt-2">
                                    <i class="bi bi-arrow-up-short"></i> +12% this week
                                </span>
                            </div>
                            <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                                <i class="bi bi-currency-dollar fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Total Orders -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Total Orders</span>
                                <h3 class="fw-bold text-dark mt-2 mb-0">342</h3>
                                <span class="badge bg-primary-subtle text-primary mt-2">
                                    <i class="bi bi-bag-check me-1"></i> 18 Pending
                                </span>
                            </div>
                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                                <i class="bi bi-receipt fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Menu Items -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Active Menu Items</span>
                                <h3 class="fw-bold text-dark mt-2 mb-0">36</h3>
                                <span class="badge bg-success-subtle text-success mt-2">
                                    <i class="bi bi-check-circle me-1"></i> 32 In Stock
                                </span>
                            </div>
                            <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                                <i class="bi bi-pie-chart-fill fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Total Customers -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Registered Customers</span>
                                <h3 class="fw-bold text-dark mt-2 mb-0">1,240</h3>
                                <span class="badge bg-info-subtle text-info mt-2">
                                    <i class="bi bi-person-plus me-1"></i> +14 today
                                </span>
                            </div>
                            <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                                <i class="bi bi-people-fill fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Main Workspace Row -->
        <div class="row g-4 mb-4">

            <!-- Expanded Recent Orders Section (Left 8 Columns) -->
            <div class="col-12 col-xl-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-header bg-white p-4 border-bottom d-flex align-items-center justify-content-between">
                        <div>
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="bi bi-clock-history text-danger me-2"></i>Recent Orders
                            </h5>
                            <span class="text-muted small">Live transactions update</span>
                        </div>
                        <a href="#" class="btn btn-sm btn-outline-danger rounded-3 fw-semibold">View All Orders</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-muted small text-uppercase">
                                    <tr>
                                        <th class="ps-4 py-3">Order ID</th>
                                        <th class="py-3">Customer</th>
                                        <th class="py-3">Items</th>
                                        <th class="py-3">Amount</th>
                                        <th class="py-3">Status</th>
                                        <th class="pe-4 py-3 text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="ps-4 fw-bold text-danger">#ORD-1092</td>
                                        <td>
                                            <div class="fw-semibold text-dark">John Doe</div>
                                            <span class="text-muted small">john@example.com</span>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">2x Pepperoni</span></td>
                                        <td class="fw-bold text-dark">$34.50</td>
                                        <td>
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">
                                                Preparing
                                            </span>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <button class="btn btn-sm btn-light border rounded-2 me-1" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-light border text-danger rounded-2" title="Cancel">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="ps-4 fw-bold text-danger">#ORD-1091</td>
                                        <td>
                                            <div class="fw-semibold text-dark">Sarah Smith</div>
                                            <span class="text-muted small">sarah@example.com</span>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">1x Margherita</span></td>
                                        <td class="fw-bold text-dark">$18.99</td>
                                        <td>
                                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1">
                                                Out for Delivery
                                            </span>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <button class="btn btn-sm btn-light border rounded-2 me-1" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-light border text-danger rounded-2" title="Cancel">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="ps-4 fw-bold text-danger">#ORD-1090</td>
                                        <td>
                                            <div class="fw-semibold text-dark">Michael Brown</div>
                                            <span class="text-muted small">michael@example.com</span>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">3x BBQ Chicken</span></td>
                                        <td class="fw-bold text-dark">$45.00</td>
                                        <td>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                                Delivered
                                            </span>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <button class="btn btn-sm btn-light border rounded-2 me-1" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-light border text-danger rounded-2" title="Cancel">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="ps-4 fw-bold text-danger">#ORD-1089</td>
                                        <td>
                                            <div class="fw-semibold text-dark">Emily Davis</div>
                                            <span class="text-muted small">emily@example.com</span>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">1x Supreme Feast</span></td>
                                        <td class="fw-bold text-dark">$22.40</td>
                                        <td>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                                Delivered
                                            </span>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <button class="btn btn-sm btn-light border rounded-2 me-1" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-light border text-danger rounded-2" title="Cancel">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Side Column: Management & Stats Breakdown (Right 4 Columns) -->
            <div class="col-12 col-xl-4">

                <!-- Quick Management Links -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white p-4 border-bottom">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-gear-fill text-danger me-2"></i>Quick Management
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-grid gap-3">

                            <a asp-controller="Pizza" asp-action="Index" class="btn btn-light border p-3 text-start rounded-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-danger text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-pie-chart-fill"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">Manage Pizza Menu</h6>
                                        <span class="text-muted small">View, Edit, or Add items</span>
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>

                            <a href="#" class="btn btn-light border p-3 text-start rounded-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-bag-check-fill"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">Customer Orders</h6>
                                        <span class="text-muted small">Update delivery statuses</span>
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>

                            <a href="#" class="btn btn-light border p-3 text-start rounded-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-info text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-people-fill"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">Customer Accounts</h6>
                                        <span class="text-muted small">Manage access & roles</span>
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>

                        </div>
                    </div>
                </div>

                <!-- Kitchen & Sales Progress Widget -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white p-4 border-bottom">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-graph-up-arrow text-danger me-2"></i>Daily Target Status
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small fw-bold mb-1">
                                <span>Revenue Goal ($15,000)</span>
                                <span class="text-success">83%</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: 83%"></div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between small fw-bold mb-1">
                                <span>Kitchen Capacity</span>
                                <span class="text-warning">65%</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-warning" role="progressbar" style="width: 65%"></div>
                            </div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between small fw-bold mb-1">
                                <span>On-Time Delivery Rate</span>
                                <span class="text-danger">94%</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-danger" role="progressbar" style="width: 94%"></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <!-- Top Selling Items Row -->
        <div class="row g-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white p-4 border-bottom">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-fire text-danger me-2"></i>Top Selling Pizzas Today
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">Pepperoni Feast</h6>
                                        <span class="text-muted small">142 Orders</span>
                                    </div>
                                    <span class="badge bg-danger fs-6">$18.99</span>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">Cheesy Margherita</h6>
                                        <span class="text-muted small">98 Orders</span>
                                    </div>
                                    <span class="badge bg-danger fs-6">$14.50</span>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">Smokey BBQ Chicken</h6>
                                        <span class="text-muted small">76 Orders</span>
                                    </div>
                                    <span class="badge bg-danger fs-6">$20.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>