@model Pizza_Delievery_System.Models.Toppings

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add New Topping";
}

<div class="bg-light min-vh-100 py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">

                <!-- Header & Navigation -->
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <a asp-action="ToppingList" class="text-danger text-decoration-none fw-semibold small">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <h2 class="fw-bold mb-0 mt-1">Add New Topping</h2>
                    </div>
                    <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill">
                        <i class="bi bi-gear-fill me-1"></i> Admin Menu
                    </span>
                </div>

                <!-- Form Card -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-danger text-white p-4 border-0">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-white text-danger d-flex align-items-center justify-content-center fs-3" style="width: 50px; height: 50px;">
                                <i class="bi bi-plus-lg"></i>
                            </div>
                            <div>
                                <h4 class="mb-0 fw-bold">Topping Details</h4>
                                <p class="text-white-50 small mb-0">Fill in the item details to add a new topping option</p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4 p-md-5 bg-white">
                        <form asp-action="AddTopping" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                            <div class="row g-3">

                                <!-- Topping Name -->
                                <div class="col-12 col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Name" class="form-control" placeholder="Pepperoni" id="toppingName" />
                                        <label for="toppingName">
                                            <i class="bi bi-egg-fried text-danger me-1"></i> Topping Name
                                        </label>
                                    </div>
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>

                                <!-- Price -->
                                <div class="col-12 col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="1.50" id="toppingPrice" />
                                        <label for="toppingPrice">
                                            <i class="bi bi-currency-dollar text-danger me-1"></i> Price ($)
                                        </label>
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger small"></span>
                                </div>

                                <!-- Description -->
                                <div class="col-12">
                                    <div class="form-floating">
                                        <textarea asp-for="Description" class="form-control" placeholder="Topping description..." id="toppingDesc" style="height: 110px"></textarea>
                                        <label for="toppingDesc">
                                            <i class="bi bi-card-text text-danger me-1"></i> Description
                                        </label>
                                    </div>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>

                                <!-- Stock Quantity -->
                                <div class="col-12 col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="StockQuantity" type="number" class="form-control" placeholder="100" id="stockQty" />
                                        <label for="stockQty">
                                            <i class="bi bi-boxes text-danger me-1"></i> Stock Quantity
                                        </label>
                                    </div>
                                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                                </div>

                                <!-- Low Stock Threshold -->
                                <div class="col-12 col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="LowStockThreshold" type="number" class="form-control" placeholder="10" id="lowStockThreshold" />
                                        <label for="lowStockThreshold">
                                            <i class="bi bi-exclamation-triangle text-danger me-1"></i> Low Stock Threshold
                                        </label>
                                    </div>
                                    <span asp-validation-for="LowStockThreshold" class="text-danger small"></span>
                                </div>

                                <!-- Is Available Switch -->
                                <div class="col-12 mt-4">
                                    <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-between border">
                                        <div>
                                            <label class="fw-bold mb-0 text-dark" for="isAvailableSwitch">
                                                Available for Ordering
                                            </label>
                                            <div class="text-muted small">
                                                Toggle whether customers can see and order this topping immediately.
                                            </div>
                                        </div>
                                        <div class="form-check form-switch fs-4 mb-0">
                                            <input asp-for="IsAvailable" class="form-check-input" type="checkbox" role="switch" id="isAvailableSwitch" checked />
                                        </div>
                                    </div>
                                    <span asp-validation-for="IsAvailable" class="text-danger small"></span>
                                </div>

                            </div>

                            <!-- Buttons -->
                            <div class="d-flex align-items-center justify-content-end gap-2 mt-5 pt-3 border-top">
                                <a asp-action="ToppingList" class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold">
                                    Cancel
                                </a>
                                <button type="submit" class="btn btn-danger px-4 py-2 rounded-3 fw-bold shadow-sm">
                                    <i class="bi bi-check-circle me-1"></i> Create Topping
                                </button>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}