@model Pizza_Delievery_System.Models.CustomPizza

@{
    ViewData["Title"] = "Create Custom Pizza";
}

<div class="container py-4">

    <!-- Header Navigation -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <a asp-action="Index" class="text-danger text-decoration-none fw-bold small">
                <i class="bi bi-arrow-left me-1"></i> Back to Menu
            </a>
            <h1 class="fw-bold text-dark display-6 mb-0 mt-1">Build Your Own Pizza 🍕</h1>
            <p class="text-muted small mb-0">Craft your custom pizza with fresh ingredients</p>
        </div>
        <span class="badge bg-danger text-uppercase px-3 py-2 rounded-pill fs-6 shadow-sm">
            <i class="bi bi-sliders me-1"></i> Customizer
        </span>
    </div>

    <!-- Main Builder Container -->
    <div class="card bg-black text-white rounded-4 shadow-lg border-0 overflow-hidden">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-4 g-lg-5 align-items-center">

                <!-- Left Column: Pizza Visual Preview -->
                <div class="col-12 col-lg-5 text-center">
                    <div class="p-4 rounded-4 bg-dark border border-secondary border-opacity-25 position-relative">
                        <span class="badge bg-danger position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill">
                            Freshly Crafted
                        </span>

                        <img src="~/All_Images/ht.jpg" alt="Custom Pizza Preview" class="img-fluid rounded-circle shadow-lg my-3" />

                        <h4 class="fw-bold text-white mb-1">Your Custom Pizza</h4>
                        <p class="text-secondary small mb-0">Select your size, crust base, sauce, cheese, and topping below!</p>
                    </div>
                </div>

                <!-- Right Column: Pizza Customizer Form -->
                <div class="col-12 col-lg-7">
                    <form asp-action="Custom_Pizza" method="post">

                        <div class="mb-4">
                            <h3 class="fw-bold text-danger mb-1">Choose Ingredients</h3>
                            <p class="text-secondary small">Customize each layer of your pizza</p>
                        </div>

                        <div class="row g-3">

                            <!-- Size Selection -->
                            <div class="col-12">
                                <div class="form-floating">
                                    <select asp-for="Size" class="form-select bg-dark text-white border-secondary" id="sizeSelect">
                                        <option value="" class="bg-dark text-white">-- Select Size --</option>
                                        <option value="Small" class="bg-dark text-white">Small (8 inch)</option>
                                        <option value="Medium" class="bg-dark text-white">Medium (12 inch)</option>
                                        <option value="Large" class="bg-dark text-white">Large (16 inch)</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Pizza Base Selection -->
                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <select asp-for="PizzaBaseID" class="form-select bg-dark text-white border-secondary" id="pizzaBaseSelect">
                                        <option value="" class="bg-dark text-white">-- Choose Crust Base --</option>
                                        @if (ViewBag.PizzaBase != null)
                                        {
                                            @foreach (var item in ViewBag.PizzaBase)
                                            {
                                                <option value="@item.PizzaBaseID" class="bg-dark text-white">@item.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <!-- Sauce Selection -->
                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <select asp-for="SauceID" class="form-select bg-dark text-white border-secondary" id="sauceSelect">
                                        <option value="" class="bg-dark text-white">-- Select Sauce --</option>
                                        @if (ViewBag.Sauce != null)
                                        {
                                            @foreach (var item in ViewBag.Sauce)
                                            {
                                                <option value="@item.SauceID" class="bg-dark text-white">@item.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <!-- Cheese Selection -->
                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <select asp-for="CheeseID" class="form-select bg-dark text-white border-secondary" id="cheeseSelect">
                                        <option value="" class="bg-dark text-white">-- Choose Cheese --</option>
                                        @if (ViewBag.Cheese != null)
                                        {
                                            @foreach (var item in ViewBag.Cheese)
                                            {
                                                <option value="@item.CheeseID" class="bg-dark text-white">@item.Name</option>
                                            }
                                        }
                                    </select> 
                                </div>
                            </div>

                            @* <!-- Topping Selection -->
                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <select asp-for="ToppingID" class="form-select bg-dark text-white border-secondary" id="toppingSelect">
                                        <option value="" class="bg-dark text-white">-- Select Size --</option>
                                        <option value="Chicken Fajita" class="bg-dark text-white">Fajita Chicken</option>
                                    </select>
                                </div>
                            </div> *@

                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex align-items-center justify-content-end gap-3 mt-4 pt-4 border-top border-secondary border-opacity-50">
                            <a asp-action="Index" class="btn btn-outline-light px-4 py-2 rounded-3 fw-semibold">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg px-4 py-2 rounded-3 fw-bold shadow d-inline-flex align-items-center gap-2">
                                <i class="bi bi-cart-plus-fill fs-5"></i> Add to Cart
                            </button>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>

</div>