@{
    ViewData["Title"] = "Contact Us";
}

<!-- Page Header -->
<section class="bg-dark text-white py-5 mb-5">
    <div class="container py-3">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="text-danger fw-bold small">
                    <i class="bi bi-chat-dots-fill me-2"></i>
                    WE'RE HERE TO HELP
                </span>

                <h1 class="display-4 fw-bold mt-2 mb-3">
                    Get In <span class="text-danger">Touch</span>
                </h1>

                <p class="lead text-white-50 mb-0">
                    Have a question, feedback, or need help with your order?
                    Our team is always ready to help.
                </p>
            </div>

            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <i class="bi bi-headset text-danger"
                   style="font-size: 7rem;"></i>
            </div>
        </div>
    </div>
</section>


<!-- Contact Content -->
<section class="container mb-5">

    <div class="row g-5">

        <!-- Contact Information -->
        <div class="col-lg-5">

            <span class="text-danger fw-bold small">
                CONTACT US
            </span>

            <h2 class="fw-bold mt-2 mb-3">
                Let's talk about
                <span class="text-danger">your pizza.</span>
            </h2>

            <p class="text-muted mb-4">
                Whether you have a question about our menu, your delivery,
                an order, or simply want to share your experience,
                we'd love to hear from you.
            </p>


            <!-- Phone -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-4 d-flex align-items-center">

                    <div class="bg-danger bg-opacity-10 text-danger rounded-3
                        d-flex align-items-center justify-content-center
                        flex-shrink-0"
                         style="width:50px;height:50px;">

                        <i class="bi bi-telephone-fill fs-5"></i>

                    </div>

                    <div class="ms-3">
                        <small class="text-muted d-block">
                            Call Us
                        </small>

                        <strong class="d-block">
                            +92 300 1234567
                        </strong>

                        <small class="text-muted">
                            Available every day
                        </small>
                    </div>

                </div>
            </div>


            <!-- Email -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-4 d-flex align-items-center">

                    <div class="bg-danger bg-opacity-10 text-danger rounded-3
                        d-flex align-items-center justify-content-center
                        flex-shrink-0"
                         style="width:50px;height:50px;">

                        <i class="bi bi-envelope-fill fs-5"></i>

                    </div>

                    <div class="ms-3">
                        <small class="text-muted d-block">
                            Email Us
                        </small>

                        <strong class="d-block">
                            support@pizzahouse.com
                        </strong>

                        <small class="text-muted">
                            We reply within 24 hours
                        </small>
                    </div>

                </div>
            </div>


            <!-- Location -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-4 d-flex align-items-center">

                    <div class="bg-danger bg-opacity-10 text-danger rounded-3
                        d-flex align-items-center justify-content-center
                        flex-shrink-0"
                         style="width:50px;height:50px;">

                        <i class="bi bi-geo-alt-fill fs-5"></i>

                    </div>

                    <div class="ms-3">
                        <small class="text-muted d-block">
                            Visit Us
                        </small>

                        <strong class="d-block">
                            PizzaHouse Main Branch
                        </strong>

                        <small class="text-muted">
                            Open for dine-in & takeaway
                        </small>
                    </div>

                </div>
            </div>


            <!-- Opening Hours -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 d-flex align-items-center">

                    <div class="bg-danger bg-opacity-10 text-danger rounded-3
                        d-flex align-items-center justify-content-center
                        flex-shrink-0"
                         style="width:50px;height:50px;">

                        <i class="bi bi-clock-fill fs-5"></i>

                    </div>

                    <div class="ms-3">
                        <small class="text-muted d-block">
                            Opening Hours
                        </small>

                        <strong class="d-block">
                            11:00 AM – 12:00 AM
                        </strong>

                        <small class="text-muted">
                            Monday – Sunday
                        </small>
                    </div>

                </div>
            
            

            </div>

        </div>


        <!-- Contact Form -->
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="d-flex justify-content-between
                        align-items-center mb-4">

                        <div>
                            <span class="text-danger fw-bold small">
                                DROP US A MESSAGE
                            </span>

                            <h3 class="fw-bold mt-1 mb-0">
                                How can we help?
                            </h3>
                        </div>

                        <div class="bg-danger text-white rounded-3
                            d-flex align-items-center
                            justify-content-center"
                             style="width:50px;height:50px;">

                            <i class="bi bi-send-fill"></i>

                        </div>

                    </div>


                    <form>

                        <div class="row g-3 mt-4">

                            <!-- Name -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Full Name
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-white">
                                        <i class="bi bi-person text-danger"></i>
                                    </span>

                                    <input type="text"
                                           class="form-control"
                                           placeholder="Enter your name"
                                           required />

                                </div>

                            </div>


                            <!-- Email -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Email Address
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-white">
                                        <i class="bi bi-envelope text-danger"></i>
                                    </span>

                                    <input type="email"
                                           class="form-control"
                                           placeholder="Enter your email"
                                           required />

                                </div>

                            </div>


                            <!-- Phone -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Phone Number
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-white">
                                        <i class="bi bi-telephone text-danger"></i>
                                    </span>

                                    <input type="tel"
                                           class="form-control"
                                           placeholder="03XX XXXXXXX" />

                                </div>

                            </div>


                            <!-- Subject -->
                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Subject
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-white">
                                        <i class="bi bi-chat-left-text text-danger"></i>
                                    </span>

                                    <select class="form-select" required>

                                        <option value="" selected disabled>
                                            Select a subject
                                        </option>

                                        <option>
                                            Order Related
                                        </option>

                                        <option>
                                            Delivery
                                        </option>

                                        <option>
                                            Feedback
                                        </option>

                                        <option>
                                            Complaint
                                        </option>

                                        <option>
                                            Other
                                        </option>

                                    </select>

                                </div>

                            </div>


                            <!-- Message -->
                            <div class="col-12">

                                <label class="form-label fw-semibold">
                                    Your Message
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-white
                                        align-items-start pt-3">

                                        <i class="bi bi-pencil-square text-danger"></i>

                                    </span>

                                    <textarea class="form-control"
                                              rows="6"
                                              placeholder="Tell us how we can help..."
                                              required></textarea>

                                </div>

                            </div>


                            <!-- Submit -->
                            <div class="col-12 mt-4">

                                <button type="submit"
                                        class="btn btn-danger w-100 py-3 fw-semibold">

                                    Send Message

                                    <i class="bi bi-arrow-right ms-2"></i>

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Order Help -->
<section class="container mb-5">

    <div class="bg-dark text-white rounded-4 p-4 p-md-5">

        <div class="row align-items-center">

            <div class="col-md-8">

                <div class="d-flex align-items-center">

                    <i class="bi bi-geo-alt-fill text-danger fs-2 me-3"></i>

                    <div>

                        <small class="text-danger fw-bold">
                            NEED HELP WITH AN ORDER?
                        </small>

                        <h3 class="fw-bold mb-1 mt-1">
                            Track your pizza in real time.
                        </h3>

                        <p class="text-white-50 mb-0">
                            Check your order status and see when your
                            favorite pizza will arrive.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4 text-md-end mt-4 mt-md-0">

                <a asp-controller="Order"
                   asp-action="Track"
                   class="btn btn-danger px-4 py-2">

                    Track Order

                    <i class="bi bi-arrow-right ms-2"></i>

                </a>

            </div>

        </div>

    </div>

</section>