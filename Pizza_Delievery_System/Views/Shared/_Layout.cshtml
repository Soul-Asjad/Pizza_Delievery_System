@{
    var User_Role = Context.Session.GetString("User_Role");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PizzaHouse</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <nav class="navbar navbar-expand-lg pizza-navbar sticky-top">

        <div class="container">

            <a class="navbar-brand pizza-brand" asp-controller="Home" asp-action="Index">
                 <span class="brand-pizza">Pizza</span><span class="brand-house">House</span>
            </a>

            <button class="navbar-toggler shadow-none border-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <i class="bi bi-list fs-2"></i>

            </button>


            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav mx-auto mb-3 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link pizza-nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle pizza-nav-link"
                           href="#"
                           id="menuDropdown"
                           role="button"
                           aria-expanded="false">
                            Menu
                        </a>

                        <ul class="dropdown-menu shadow border-0 rounded-3"
                            aria-labelledby="menuDropdown">

                            <li class="dropdown-submenu">
                                <a class="dropdown-item d-flex justify-content-between align-items-center"
                                   href="#">
                                    <span>
                                        <i class="bi bi-egg-fried text-danger me-2"></i>
                                        Chicken Pizzas
                                    </span>
                                    <i class="bi bi-chevron-right small"></i>
                                </a>

                                <ul class="dropdown-menu shadow border-0 rounded-3">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Chicken">
                                            Chicken Supreme
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Chicken">
                                            BBQ Chicken
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Chicken">
                                            Chicken Tikka
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Chicken">
                                            Chicken Fajita
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- Beef -->
                            <li class="dropdown-submenu">
                                <a class="dropdown-item d-flex justify-content-between align-items-center"
                                   href="#">
                                    <span>
                                        <i class="bi bi-fire text-danger me-2"></i>
                                        Beef Pizzas
                                    </span>
                                    <i class="bi bi-chevron-right small"></i>
                                </a>

                                <ul class="dropdown-menu shadow border-0 rounded-3">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Beef">
                                            Beef Supreme
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Beef">
                                            BBQ Beef
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Beef">
                                            Beef & Mushroom
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- Pepperoni -->
                            <li class="dropdown-submenu">
                                <a class="dropdown-item d-flex justify-content-between align-items-center"
                                   href="#">
                                    <span>
                                        <i class="bi bi-circle-fill text-danger me-2"></i>
                                        Pepperoni
                                    </span>
                                    <i class="bi bi-chevron-right small"></i>
                                </a>

                                <ul class="dropdown-menu shadow border-0 rounded-3">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Pepperoni">
                                            Pepperoni Feast
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Pepperoni">
                                            Double Pepperoni
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Pepperoni">
                                            Pepperoni & Cheese
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- Cheese -->
                            <li class="dropdown-submenu">
                                <a class="dropdown-item d-flex justify-content-between align-items-center"
                                   href="#">
                                    <span>
                                        <i class="bi bi-star-fill text-danger me-2"></i>
                                        Cheese Pizzas
                                    </span>
                                    <i class="bi bi-chevron-right small"></i>
                                </a>

                                <ul class="dropdown-menu shadow border-0 rounded-3">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Cheese">
                                            Four Cheese
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Cheese">
                                            Cheese Lover
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Cheese">
                                            Mozzarella Classic
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- Vegetarian -->
                            <li class="dropdown-submenu">
                                <a class="dropdown-item d-flex justify-content-between align-items-center"
                                   href="#">
                                    <span>
                                        <i class="bi bi-flower1 text-danger me-2"></i>
                                        Vegetarian
                                    </span>
                                    <i class="bi bi-chevron-right small"></i>
                                </a>

                                <ul class="dropdown-menu shadow border-0 rounded-3">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Vegetarian">
                                            Veggie Supreme
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Vegetarian">
                                            Garden Fresh
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Vegetarian">
                                            Mushroom & Olive
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- Spicy -->
                            <li class="dropdown-submenu">
                                <a class="dropdown-item d-flex justify-content-between align-items-center"
                                   href="#">
                                    <span>
                                        <i class="bi bi-fire text-danger me-2"></i>
                                        Spicy Pizzas
                                    </span>
                                    <i class="bi bi-chevron-right small"></i>
                                </a>

                                <ul class="dropdown-menu shadow border-0 rounded-3">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Spicy">
                                            Spicy Chicken
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Spicy">
                                            Peri Peri Chicken
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pizza"
                                           asp-action="Index"
                                           asp-route-category="Spicy">
                                            Jalapeño Special
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <a class="dropdown-item fw-semibold text-danger"
                                   asp-controller="Pizza"
                                   asp-action="Index">
                                    <i class="bi bi-grid me-2"></i>
                                    View All Pizzas
                                </a>
                            </li>

                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link pizza-nav-link"
                           asp-controller="Pizza"
                           asp-action="Customize">
                            Build Pizza
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link pizza-nav-link"
                           asp-controller="Home"
                           asp-action="Deals">
                            Deals
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link pizza-nav-link"
                           asp-controller="Home"
                           asp-action="Contact">
                            Contact us 
                        </a>
                    </li>

                    @if(!string.IsNullOrEmpty(User_Role))
                        {
                        <li class="nav-item">
                            <a class="nav-link pizza-nav-link"
                               asp-controller="User"
                               asp-action="Logout">
                                Logout
                            </a>
                        </li>
                        }

                </ul>


                <!-- Right Side -->
                <div class="d-flex align-items-center gap-2">

                    <!-- Search -->
                    <div class="pizza-search d-none d-xl-flex">

                        <input type="text"
                               class="form-control"
                               placeholder="Search pizza..." />

                        <button type="button">
                            <i class="bi bi-search"></i>
                        </button>

                    </div>


                    <!-- Cart -->
                    <a asp-controller="Cart"
                       asp-action="Index"
                       class="pizza-cart">

                        <i class="bi bi-cart3"></i>

                        <span class="pizza-cart-count">
                            0
                        </span>

                    </a>


                    <!-- Login -->
                    <a asp-controller="User"
                       asp-action="Login"
                       class="btn pizza-login-btn">

                        Sign In

                    </a>

                </div>

            </div>

        </div>

    </nav>


    <!-- =========================
         PAGE CONTENT
    ========================== -->

    <main>
        @RenderBody()
    </main>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer class="bg-dark text-white pt-5 pb-4 mt-auto">

        <div class="container">

            <div class="row g-4">

                <!-- Brand -->
                <div class="col-lg-4">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="fs-3 fw-bold text-decoration-none text-white">

                        <span class="text-danger">Pizza</span>House

                    </a>

                    <p class="text-white-50 mt-3 small">

                        Freshly prepared pizzas, delicious sides and
                        fast delivery. Your favorite pizza is just
                        a few clicks away.

                    </p>


                    <!-- Social -->
                    <div class="d-flex gap-2 mt-4">

                        <a href="#" class="btn btn-outline-light rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 38px; height: 38px;">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#" class="btn btn-outline-light rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 38px; height: 38px;">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="#" class="btn btn-outline-light rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 38px; height: 38px;">
                            <i class="bi bi-twitter-x"></i>
                        </a>

                        <a href="#" class="btn btn-outline-light rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 38px; height: 38px;">
                            <i class="bi bi-tiktok"></i>
                        </a>

                    </div>

                </div>


                <!-- Menu -->
                <div class="col-6 col-md-4 col-lg-2">

                    <h6 class="fw-bold text-uppercase mb-3 text-white">
                        Menu
                    </h6>

                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li>
                            <a asp-controller="Pizza" asp-action="Index" class="text-white-50 text-decoration-none small hover-white">
                                Pizzas
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Deals" class="text-white-50 text-decoration-none small hover-white">
                                Deals
                            </a>
                        </li>
                        <li>
                            <a href="#" class="text-white-50 text-decoration-none small hover-white">
                                Appetizers
                            </a>
                        </li>
                        <li>
                            <a href="#" class="text-white-50 text-decoration-none small hover-white">
                                Beverages
                            </a>
                        </li>
                    </ul>

                </div>


                <!-- Account -->
                <div class="col-6 col-md-4 col-lg-2">

                    <h6 class="fw-bold text-uppercase mb-3 text-white">
                        Account
                    </h6>

                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li>
                            <a asp-controller="Account" asp-action="Login" class="text-white-50 text-decoration-none small hover-white">
                                My Account
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Order" asp-action="Index" class="text-white-50 text-decoration-none small hover-white">
                                My Orders
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Order" asp-action="Track" class="text-white-50 text-decoration-none small hover-white">
                                Track Order
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Cart" asp-action="Index" class="text-white-50 text-decoration-none small hover-white">
                                Cart
                            </a>
                        </li>
                    </ul>

                </div>


                <!-- Contact -->
                <div class="col-md-4 col-lg-4">

                    <h6 class="fw-bold text-uppercase mb-3 text-white">
                        Contact & Support
                    </h6>

                    <div class="text-white-50 small">

                        <div class="d-flex gap-3 mb-3 align-items-center">

                            <i class="bi bi-telephone text-danger fs-5"></i>

                            <span>
                                +92 300 1234567
                            </span>

                        </div>


                        <div class="d-flex gap-3 mb-3 align-items-center">

                            <i class="bi bi-envelope text-danger fs-5"></i>

                            <span>
                                support@pizzahouse.com
                            </span>

                        </div>


                        <div class="d-flex gap-3 align-items-center">

                            <i class="bi bi-clock text-danger fs-5"></i>

                            <span>
                                Mon - Sun: 11:00 AM - 12:00 AM
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Footer Bottom -->
            <div class="border-top border-secondary border-opacity-50 mt-5 pt-4">

                <div class="row align-items-center g-2">

                    <div class="col-md-6">

                        <p class="mb-0 text-white-50 small">
                            © 2026 PizzaHouse. All rights reserved.
                        </p>

                    </div>

                    <div class="col-md-6 text-md-end">

                        <a href="#" class="text-white-50 text-decoration-none small hover-white">
                            Privacy Policy
                        </a>

                        <a href="#" class="text-white-50 text-decoration-none small hover-white ms-3">
                            Terms & Conditions
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </footer>


    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>