@model Pizza_Delievery_System.Models.Pizza

@{
    ViewData["Title"] = "Edit";
}

<div class="bg-light min-vh-100 py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">

                <!-- Header & Navigation -->
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <a asp-action="PizzaList" class="text-danger text-decoration-none fw-semibold small">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <h2 class="fw-bold mb-0 mt-1">Edit Pizza</h2>
                    </div>
                    <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill">
                        <i class="bi bi-pencil-square me-1"></i> Admin Menu
                    </span>
                </div>

                <!-- Form Card -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-danger text-white p-4 border-0">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-white text-danger d-flex align-items-center justify-content-center fs-3" style="width: 50px; height: 50px;">
                                <i class="bi bi-pencil-fill"></i>
                            </div>
                            <div>
                                <h4 class="mb-0 fw-bold">Update Pizza Information</h4>
                                <p class="text-white-50 small mb-0">Modify details for this menu item</p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4 p-md-5 bg-white">
                        <form asp-action="Edit" asp-controller="Pizza" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <!-- Hidden ID Field -->
                            <input type="hidden" asp-for="PizzaID" />

                            <div class="row g-3">

                                <!-- Current Image Preview -->
                                <div class="col-12 mb-2">
                                    <div class="p-3 bg-light rounded-3 d-flex align-items-center gap-3 border">
                                        <img src="@Url.Content("~/All_Images/Pizza/" + Model.Image)"
                                             alt="@Model.Name"
                                             class="rounded-3 border object-fit-cover shadow-sm"
                                             style="width: 70px; height: 70px;" />
                                        <div>
                                            <span class="text-muted small d-block">Current Image File</span>
                                            <span class="fw-semibold text-dark">@Model.Image</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Pizza Name -->
                                <div class="col-12 col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Name" class="control-label fw-semibold text-muted small mb-1"></label>
                                        <input asp-for="Name" class="form-control" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Price -->
                                <div class="col-12 col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Price" class="control-label fw-semibold text-muted small mb-1"></label>
                                        <input asp-for="Price" class="form-control" />
                                        <span asp-validation-for="Price" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Description -->
                                <div class="col-12">
                                    <div class="form-group">
                                        <label asp-for="Description" class="control-label fw-semibold text-muted small mb-1"></label>
                                        <input asp-for="Description" class="form-control" />
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Image Path -->
                                <div class="col-12 col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Image" class="control-label fw-semibold text-muted small mb-1"></label>
                                        <input type="file" asp-for="Image" class="form-control" />
                                        <span asp-validation-for="Image" class="text-danger"></span>
                                    </div>
                                </div>


                                <!-- Is Available -->
                                <div class="col-12 mt-3">
                                    <div class="form-group p-3 bg-light rounded-3 border d-flex align-items-center gap-2">
                                        <input asp-for="IsAvaiable" class="form-check-input mt-0" type="checkbox" />
                                        <label asp-for="IsAvaiable" class="form-check-label fw-semibold text-dark mb-0"></label>
                                        <span asp-validation-for="IsAvaiable" class="text-danger"></span>
                                    </div>
                                </div>

                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
                                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold">
                                    Back to List
                                </a>
                                <input type="submit" value="Save" class="btn btn-danger px-4 py-2 rounded-3 fw-bold shadow-sm" />
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}