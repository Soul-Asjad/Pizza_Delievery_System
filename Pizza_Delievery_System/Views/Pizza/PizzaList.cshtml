@model IEnumerable<Pizza_Delievery_System.Models.Pizza>

@{
    ViewData["Title"] = "Pizza Menu Management";
}

<div class="bg-light min-vh-100 py-5">
    <div class="container">

        <!-- Top Header & Actions Bar -->
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
            <div>
                <a asp-controller="Home" asp-action="Index" class="text-danger text-decoration-none fw-semibold small">
                    <i class="bi bi-arrow-left me-1"></i> Dashboard
                </a>
                <h2 class="fw-bold mb-0 mt-1">Pizza Menu Items</h2>
                <p class="text-muted small mb-0">Manage all pizza varieties, prices, and availability.</p>
            </div>

            <a asp-action="AddPizza" class="btn btn-danger btn-lg px-4 rounded-3 fw-bold shadow-sm d-inline-flex align-items-center">
                <i class="bi bi-plus-lg me-2"></i> Add New Pizza
            </a>
        </div>

        <!-- Main Card Container -->
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

            <div class="card-header bg-white p-4 border-bottom d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-pie-chart-fill fs-5"></i>
                    </div>
                    <h5 class="fw-bold mb-0 text-dark">All Items (@(Model?.Count() ?? 0))</h5>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-uppercase fs-7 text-muted border-bottom">
                            <tr>
                                <th class="ps-4 py-3">Pizza</th>
                                <th class="py-3">Description</th>
                                <th class="py-3">Price</th>
                                <th class="py-3 text-center">Status</th>
                                <th class="py-3">Created Date</th>
                                <th class="pe-4 py-3 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <!-- Image + Name -->
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="~/All_Images/Pizza/@item.Image"
                                                     alt="@item.Name"
                                                     class="rounded-3 border object-fit-cover shadow-sm"
                                                     style="width: 60px; height: 60px;"
                                                     onerror="this.src='https://via.placeholder.com/60?text=Pizza';" />
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-0">@item.Name</h6>
                                                    <span class="text-muted small">ID: #@item.PizzaID</span>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Description -->
                                        <td class="py-3" style="max-width: 250px;">
                                            <p class="text-muted small mb-0 text-truncate" title="@item.Description">
                                                @item.Description
                                            </p>
                                        </td>

                                        <!-- Price -->
                                        <td class="py-3">
                                            <span class="fw-bold text-danger fs-6">
                                                $@item.Price.ToString("F2")
                                            </span>
                                        </td>

                                        <!-- Status Badge -->
                                        <td class="py-3 text-center">
                                            @if (item.IsAvaiable == "true")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 small fw-semibold">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Available
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-2 small fw-semibold">
                                                    <i class="bi bi-x-circle-fill me-1"></i> Unavailable
                                                </span>
                                            }
                                        </td>

                                        <!-- Created Date -->
                                        <td class="py-3 text-muted small">
                                            <i class="bi bi-calendar3 me-1 text-danger"></i>
                                            @item.CreatedDate.ToString("MMM dd, yyyy")
                                        </td>

                                        <!-- Action Buttons -->
                                        <td class="pe-4 py-3 text-end">
                                            <div class="btn-group gap-1" role="group">
                                                <a asp-action="Details" asp-route-id="@item.PizzaID" class="btn btn-sm btn-outline-secondary rounded-2" title="Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.PizzaID" class="btn btn-sm btn-outline-primary rounded-2" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.PizzaID" class="btn btn-sm btn-outline-danger rounded-2" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <div class="text-muted py-3">
                                            <i class="bi bi-pie-chart display-4 text-danger d-block mb-3 opacity-50"></i>
                                            <h5>No Pizza Items Found</h5>
                                            <p class="small mb-3">Get started by creating your first pizza menu item.</p>
                                            <a asp-action="AddPizza" class="btn btn-danger rounded-3 fw-bold btn-sm">
                                                Add Pizza Now
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </div>
</div>